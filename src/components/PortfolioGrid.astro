---
import type { WpProject } from "../lib/wordpress";

interface Props {
  projects: WpProject[];
}
const { projects } = Astro.props;
---

<section class="portfolio-grid">
  {projects.length === 0 && (
    <p class="portfolio-grid__empty">No projects published yet — check back soon.</p>
  )}

  {projects.map((project) => (
    <a href={`/works/${project.slug}`} class="pcard" data-work-card={project.category}>
      <div class="pcard__image">
        <img src={project.coverImage} alt={project.coverImageAlt || project.title} />
      </div>
      <h2 class="pcard__title">{project.title}</h2>
      {project.excerpt && <p class="pcard__excerpt">{project.excerpt}</p>}
    </a>
  ))}
</section>

<style>
  .portfolio-grid {
    max-width: 1180px;
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 4.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
  }

  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }

  .portfolio-grid__empty {
    grid-column: 1 / -1;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .pcard {
    display: flex;
    flex-direction: column;
  }

  .pcard__image {
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .pcard__image img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcard:hover .pcard__image img {
    transform: scale(1.04);
  }

  .pcard__title {
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .pcard__excerpt {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>
