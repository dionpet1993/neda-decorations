---
const heroImage = "/images/hero.webp";
---

<section class="hero">
  <img class="hero__image" src={heroImage} alt="" role="presentation" />
  <div class="hero__scrim"></div>

  <span class="hero__tag">Athens · Mykonos</span>

  <div class="hero__content">
    <h1 class="hero__mark">Neda<br />Decorations</h1>
    <p class="hero__tagline">
      We don't decorate spaces.<br />
      We create experiences.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 108svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    color: #fff;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 10%;
    z-index: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 8, 0.1) 0%,
      rgba(10, 10, 8, 0.05) 40%,
      rgba(10, 10, 8, 0.55) 100%
    );
  }

  .hero__tag {
    position: absolute;
    top: 5.5rem;
    right: var(--gutter);
    z-index: 2;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: 0 var(--gutter) clamp(3.5rem, 10vh, 6rem);
  }

  .hero__mark {
    font-size: clamp(2.75rem, 12vw, 4rem);
    letter-spacing: 0.02em;
  }

  .hero__tagline {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.6;
  }
</style>
