---
const heroImage = "/images/hero-tables.jpg";
---

<section class="hero">
  <div class="hero__photo">
    <img src={heroImage} alt="" role="presentation" />
  </div>

  <p class="hero__tagline">
    We don't decorate spaces.<br />
    We create experiences.
  </p>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 1.5rem;
    padding: 1.5rem var(--gutter) 4rem;
  }

  .hero__photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    filter: grayscale(1);
  }

  .hero__tagline {
    text-align: right;
    font-size: clamp(0.9rem, 1.8vw, 1.4rem);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.7;
    padding-bottom: 0.5rem;
  }

  @media (max-width: 420px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__tagline {
      text-align: left;
      padding-top: 1rem;
    }
  }
</style>
