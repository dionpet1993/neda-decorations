---
const fields = [
  { name: "name", label: "Name", type: "text", autocomplete: "name" },
  { name: "email", label: "Email", type: "email", autocomplete: "email" },
  { name: "phone", label: "Phone", type: "tel", autocomplete: "tel" },
];
---

<div class="contact-form">
  <p class="contact-form__eyebrow eyebrow">Enquiry</p>
  <h2 class="contact-form__heading">Tell us about your event</h2>

  <form class="contact-form__form">
    {fields.map((f) => (
      <label class="field">
        <span>{f.label}</span>
        <input type={f.type} name={f.name} autocomplete={f.autocomplete} required={f.name !== "phone"} />
      </label>
    ))}

    <label class="field">
      <span>Event type</span>
      <select name="event-type">
        <option>Wedding / private event</option>
        <option>Corporate / brand event</option>
        <option>Hospitality / retail space</option>
        <option>Interior styling</option>
        <option>Other</option>
      </select>
    </label>

    <label class="field">
      <span>Message</span>
      <textarea name="message" rows="4" required></textarea>
    </label>

    <button type="submit" class="btn">Send enquiry</button>
  </form>
</div>

<style>
  .contact-form__eyebrow {
    margin-bottom: 0.75rem;
  }

  .contact-form__heading {
    font-size: clamp(1.6rem, 5vw, 2.25rem);
    margin-bottom: 2rem;
  }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    padding: 0.6rem 0;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-ink);
    border-radius: 0;
    appearance: none;
  }

  .field select {
    background-image: linear-gradient(45deg, transparent 50%, var(--color-ink) 50%),
      linear-gradient(135deg, var(--color-ink) 50%, transparent 50%);
    background-position: right 0.3rem top 55%, right 0 top 55%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .contact-form__form .btn {
    align-self: flex-start;
    margin-top: 0.5rem;
    border-color: var(--color-ink);
    color: var(--color-ink);
  }
</style>
