---
const items = [
  "Weddings & private events",
  "Corporate & brand events",
  "Hospitality & retail spaces",
  "Interior styling & installations",
];
---

<section class="create">
  <h2 class="create__heading">What we create</h2>
  <p class="create__intro">We design complete visual experiences for:</p>
  <ul class="create__list">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</section>

<style>
  .create {
    max-width: var(--container-width);
    padding: 2.5rem var(--gutter) 3.5rem;
  }

  .create__heading {
    font-size: clamp(1.6rem, 5vw, 2rem);
    margin-bottom: 1.5rem;
  }

  .create__intro {
    font-size: 0.95rem;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }

  .create__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
</style>
