---
const locations = [
  {
    name: "Kolonaki",
    address: "12 Speusippou Street",
    phones: ["+30 210 7297010", "+30 695 982 9367"],
  },
  {
    name: "Aigaleo",
    address: "503 Thivon Avenue",
    phones: ["+30 210 5900102"],
  },
  {
    name: "Mykonos",
    address: "Elia Beach 846 00 · Myconian Imperial — Leading Hotels of the World",
    phones: ["+30 695 982 9367"],
  },
];
---

<div class="locations">
  <p class="locations__eyebrow eyebrow">Visit us</p>
  <h2 class="locations__heading">Our studios</h2>

  <ul class="locations__list">
    {locations.map((loc) => (
      <li>
        <span class="locations__name">{loc.name}</span>
        <span class="locations__address">{loc.address}</span>
        <span class="locations__phone">Tel: {loc.phones.join(", ")}</span>
      </li>
    ))}
  </ul>

  <a href="mailto:info@nedadecorations.gr" class="locations__email">info@nedadecorations.gr</a>
</div>

<style>
  .locations__eyebrow {
    margin-bottom: 0.75rem;
  }

  .locations__heading {
    font-size: clamp(1.6rem, 5vw, 2.25rem);
    margin-bottom: 2rem;
  }

  .locations__list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .locations__list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-line);
  }
  .locations__list li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .locations__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-accent);
  }

  .locations__address {
    font-size: 0.9rem;
    color: var(--color-ink);
  }

  .locations__phone {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .locations__email {
    font-size: 0.95rem;
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
  }
</style>
