---
const photo = "/images/story-detail-2.webp";
---

<section class="story">
  <div class="story__photo">
    <img src={photo} alt="" role="presentation" />
  </div>
  <h2 class="story__heading">
    Every space<br />has a story.<br />We make it<br />unforgettable.
  </h2>
</section>

<style>
  .story__photo img {
    width: 100%;
    height: clamp(420px, 65vw, 780px);
    object-fit: cover;
  }

  .story__heading {
    position: relative;
    margin: 0;
    margin-top: clamp(-7rem, -12vw, -4.5rem);
    padding: 0 var(--gutter);
    color: var(--color-ink);
    font-size: clamp(3rem, 11.5vw, 6rem);
  }
</style>
