---
const photo = "/images/story-flowers.webp";
---

<section class="story">
  <div class="story__photo">
    <img src={photo} alt="" role="presentation" />
  </div>
  <h2 class="story__heading">
    Every space<br />has a story.<br />We make it<br />unforgettable.
  </h2>
</section>

<style>
  .story__photo img {
    width: 100%;
    height: clamp(280px, 46vw, 460px);
    object-fit: cover;
  }

  .story__heading {
    position: relative;
    margin: 0;
    margin-top: clamp(-4rem, -8vw, -2.5rem);
    padding: 0 var(--gutter);
    color: var(--color-ink);
    font-size: clamp(2.1rem, 8.5vw, 3.5rem);
  }
</style>
