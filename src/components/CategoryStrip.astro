---
const categories = ["Event Design", "Space Styling", "Floral Design", "The Art of Bloom", "Artificial"];
---

<ul class="category-strip wrap">
  {categories.map((c) => <li>{c}</li>)}
</ul>

<style>
  .category-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    list-style: none;
    margin: 0;
    padding-block: 2.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
</style>
