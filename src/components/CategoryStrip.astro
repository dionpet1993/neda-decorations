---
const categories = ["Event Design", "Space Styling", "Floral Design", "The Art of Bloom", "Artificial"];
---

<ul class="category-strip">
  {categories.map((c) => <li>{c}</li>)}
</ul>

<style>
  .category-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    list-style: none;
    margin: 0;
    padding: 2.5rem var(--gutter);
    font-size: clamp(0.95rem, 1.8vw, 1.3rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
</style>
