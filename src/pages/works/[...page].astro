---
import type { GetStaticPaths } from "astro";
import { getProjects } from "../../lib/wordpress";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import WorksHeader from "../../components/WorksHeader.astro";
import PortfolioGrid from "../../components/PortfolioGrid.astro";
import PaginationNav from "../../components/PaginationNav.astro";
import Footer from "../../components/Footer.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getProjects();
  return paginate(projects, { pageSize: 18 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const allProjects = await getProjects();
const categories = [...new Set(allProjects.map((p) => p.category))];
---

<BaseLayout
  title={page.currentPage > 1 ? `Works — Page ${page.currentPage} — Neda Decorations` : "Works — Neda Decorations"}
  description="A look at recent weddings, events and spaces styled by Neda Decorations."
>
  <Nav dark />
  <WorksHeader categories={categories} />
  <PortfolioGrid projects={page.data} />
  <PaginationNav page={page} basePath="/works" />
  <Footer />
</BaseLayout>
